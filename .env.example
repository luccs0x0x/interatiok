# --- TikTok LIVE ---------------------------------------------------------
# @usuario da live (sem @ também funciona). Pode ser passado com --room=@user.
TIKTOK_USERNAME=

# Chave de assinatura do Euler Stream (https://eulerstream.com).
# Obrigatória na prática para o tiktok-live-connector v2.
TIKTOK_SIGN_API_KEY=

# Opcional: cookie `sessionid` de uma conta logada + idc (melhora autenticação).
# TRATE COMO SEGREDO. Nunca comite este arquivo preenchido.
TIKTOK_SESSIONID=
TIKTOK_TT_TARGET_IDC=useast1a
TIKTOK_FETCH_GIFT_INFO=true

# --- Servidor -------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
# Quando definido, POST /api/simulate exige o header x-sim-token.
SIM_TOKEN=

# --- Simulador (npm run simulate) -----------------------------------------
SIM_INTERVAL_MS=1200
SIM_SEED=42
SIM_EXPENSIVE_EVERY=25

# --- Personagem (LLM opcional) -------------------------------------------
# Qualquer endpoint compatível com /chat/completions (OpenAI, Groq, Ollama...).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=2500

# --- Log ------------------------------------------------------------------
LOG_LEVEL=info
