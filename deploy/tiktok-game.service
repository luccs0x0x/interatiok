[Unit]
Description=TikTok Live Game - motor do jogo interativo
Documentation=https://github.com/luccs0x0x/interatiok
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=game
Group=game
WorkingDirectory=/opt/tiktok-live-game
EnvironmentFile=/opt/tiktok-live-game/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=TZ=America/Sao_Paulo
ExecStart=/usr/bin/node dist/src/index.js
Restart=always
RestartSec=5
TimeoutStopSec=20

# Endurecimento (o processo só escreve em data/)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tiktok-live-game/data
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
